# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SPOTIFY_CLIENT_ID: Your Spotify Application Client ID
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"

# SPOTIFY_CLIENT_SECRET: Your Spotify Application Client Secret
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"

# SPOTIFY_REDIRECT_URI: Your Spotify Application Redirect URI (e.g., https://your-app.run.app/auth/callback)
SPOTIFY_REDIRECT_URI="YOUR_SPOTIFY_REDIRECT_URI"

# SESSION_SECRET: Secret key for signing cookie sessions
SESSION_SECRET="your-session-secret-here"

# Firebase Configuration
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-auth-domain"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-storage-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-firebase-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-firebase-measurement-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="your-firebase-firestore-database-id"
